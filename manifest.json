{
  "manifest_version": 3,
  "name": "Reels Blocker",
  "version": "1.0.0",
  "description": "Blocks short-form video with local Chrome rules and privacy-first permissions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Reels Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shortform_block_rules",
        "enabled": true,
        "path": "rules/block_rules.json"
      }
    ]
  }
}
